import sys
import pygame

# 1. Initialize all imported pygame modules
pygame.init()

# 2. Set up the window dimensions (Width, Height)
SCREEN_WIDTH = 800
SCREEN_HEIGHT = 600
screen = pygame.display.set_mode((SCREEN_WIDTH, SCREEN_HEIGHT))

# 3. Set the window title
pygame.display.set_caption("My Pygame Window")

# 4. Set up a clock to regulate frame rate (FPS)
clock = pygame.time.Clock()

# Define an RGB color for the background (e.g., Dark Gray)
BG_COLOR = (40, 40, 40)

# 5. The Main Game Loop
running = True
while running:
    # Look at all user events (mouse clicks, key presses)
    for event in pygame.event.get():
        # If the user clicks the "X" window button, exit the loop
        if event.type == pygame.QUIT:
            running = False

    # Fill the screen background with color
    screen.fill(BG_COLOR)

    # Update the full display Surface to the screen
    pygame.display.flip()

    # Limit the game to 60 frames per second
    clock.tick(60)

# 6. Neatly clean up and close the program
pygame.quit()
sys.exit()
